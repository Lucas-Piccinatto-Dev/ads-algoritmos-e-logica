programa {
  funcao inicio() {
    //Algoritimo maior que 10

    //-----Variaveis-----
        real numero

    //-----Entrada de dados-----
        escreva("Informe um número: ")
        eia(numero)

    //-----Processamento e Validação-----
        se(numero > 10) {

      //-----Saida de Dados-----
        escreva(numero, " é maior que 10!")
    } senao {
        escreva(numero, " não é maior que 10!")
    }
      }
}
